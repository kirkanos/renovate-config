{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMultipleMajorReleases"
  ],
  "assignees": [
    "kirkanos"
  ],
  "assignAutomerge": true,
  "platformAutomerge": true,
  "npmrc": "allow-remote=all",
  "packageRules": [
    {
      "description": "Group all non-major updates into one PR that needs a review (rules below move the automerged ones into their own group)",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    },
    {
      "description": "Automerge patch updates, digest bumps and pin requests — no review needed for these",
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "minimumReleaseAge": "4 days",
      "groupName": "automerged updates",
      "groupSlug": "automerge"
    },
    {
      "description": "Automerge minor updates of devDependencies as well",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true,
      "minimumReleaseAge": "4 days",
      "groupName": "automerged updates",
      "groupSlug": "automerge"
    },
    {
      "description": "Never automerge unstable releases, even for patch updates — they go into the reviewed group",
      "matchCurrentVersion": "!/^v?[1-9]/",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": false,
      "minimumReleaseAge": null,
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    },
    {
      "description": "Group updates for the shared pipeline runtime image and pin it by digest, since it is referenced by the floating tag :alpine",
      "matchPackageNames": [
        "registry.kirkanos.net/images/ci-build"
      ],
      "groupName": "ci-build image",
      "pinDigests": true,
      "minimumReleaseAge": null
    },
    {
      "description": "Group updates for the Hugo build image",
      "matchPackageNames": [
        "ghcr.io/gohugoio/hugo",
        "klakegg/hugo"
      ],
      "groupName": "hugo image"
    },
    {
      "description": "Group the Woodpecker server, agent and cli images, which are released together with the same version",
      "matchPackageNames": [
        "/(^|/)woodpeckerci/woodpecker-(server|agent|cli)$/"
      ],
      "groupName": "woodpecker"
    }
  ]
}
